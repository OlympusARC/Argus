# Copy to .env and fill in. Nothing here is required for a local SQLite run --
# `argus init && argus discover && argus poll` works with an empty file.
#
#   set -a; . ./.env; set +a


# ── Storage ──────────────────────────────────────────────────────────────
# Unset entirely to use SQLite at data/argus.db.
#
# Two poolers, deliberately. The workers hold one connection for a long poll
# and want the session pooler (5432); the API and dashboard are short and
# numerous and want the transaction pooler (6543).
SUPABASE_REF=
SUPABASE_REGION=us-west-2
SUPABASE_DB_PASSWORD=

# Or point straight at any Postgres and skip the three above.
# DATABASE_URL=postgresql://user:pass@host:5432/postgres


# ── LLM providers, tried in this order ───────────────────────────────────
# Lane B only. The feed lane makes no model calls -- `argus classify` is a
# regex ruleset and runs with all of these unset.
GROQ_API_KEY=
# NVIDIA_API_KEY=
# GEMINI_API_KEY=


# ── Discovery ────────────────────────────────────────────────────────────
# Raises the GitHub code-search rate limit. Without it that source still
# runs, just slower.
GITHUB_TOKEN=

# Not a key: a name and an email. SEC EDGAR requires contact details in the
# User-Agent and 403s a generic library agent. Note EDGAR also blocks some
# domains outright -- a @users.noreply.github.com address 403s exactly like
# no contact at all.
ARGUS_SEC_CONTACT=Your Name you@example.com

# Web search backend, tried in this order. TinyFish's /search is brokered by
# Monid and metered at $0 per call, so it is preferred; Brave's free tier is
# a quota. Either one alone is enough. DuckDuckGo needs no key and no longer
# works -- it answers 202 with an anti-bot page.
MONID_API_KEY=
# BRAVE_API_KEY=


# ── Delivery ─────────────────────────────────────────────────────────────
# Unset is not an error: `argus notify` prints what it would have sent.
ARGUS_DISCORD_WEBHOOK=


# ── Read API ─────────────────────────────────────────────────────────────
# A single shared key, checked against the X-API-Key header. UNSET MEANS
# OPEN, which is fine locally and should never be the case in deployment --
# the routes read the whole corpus.
ARGUS_API_KEY=


# ── Tuning (all optional; defaults shown) ────────────────────────────────
# ARGUS_WORKERS=12
# ARGUS_PER_HOST_CONCURRENCY=4
# ARGUS_HTTP_TIMEOUT=20
# ARGUS_CLOSE_GRACE_POLLS=2          polls a posting must be absent before closing
# ARGUS_MASS_CLOSE_GUARD=5           abort a write that looks like an outage
# ARGUS_DEAD_AFTER_FAILURES=8
# ARGUS_STORE_FAMILIES=engineering,fde,ai,data,security,product
# ARGUS_STORE_REGIONS=us,europe,remote,unknown
