# Supabase. Only the password is secret -- the host is derived from the project
# ref, so this is the one value that has to be filled in locally and stored as a
# GitHub Actions secret.
SUPABASE_DB_PASSWORD=

# Optional overrides. Everything in argus/core/config.py can be set this way.
# ARGUS_DB=data/argus.db          # local SQLite path; unset once Postgres is live
# ARGUS_WORKERS=12                # default fetch concurrency
# ARGUS_PER_HOST_CONCURRENCY=4    # never raise this without a reason

# Discovery sources that need credentials. Each one degrades to "unavailable"
# rather than failing the run, so leaving these blank is fine.
# GITHUB_TOKEN=                   # borrowed from `gh auth token` if unset
# BRAVE_API_KEY=                  # enables the websearch source
# ARGUS_SEC_CONTACT=              # "Name you@example.com" -- SEC requires it
